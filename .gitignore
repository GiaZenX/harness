# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python / tooling artifacts
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Throwaway E2E sandbox
.e2e-sandbox/

# Claude Code scheduled-task runtime state (not source)
.claude/scheduled_tasks.lock
